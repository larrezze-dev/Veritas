  "default_series": "steel-sections (I europeos)",
  "default_family": "I",
  "steel": true,
  "method": "Mapeo de ejemplo para los CSV ipe, hea, heb y hem del paquete PyPI steel-sections 0.2.1. No incluye datos; la licencia de los datos NO está verificada: úsese solo en local"
